            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem mensagem Urgente?": {
      "main": [
        [
          {
            "node": "Notificar (configurar depois)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nada a fazer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
